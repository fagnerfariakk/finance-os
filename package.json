{
  "name": "finance-os",
  "version": "0.1.0",
  "private": true,

  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },

  "packageManager": "pnpm@11.10.0",

  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",

    "db:generate": "pnpm --filter @finance-os/database run generate",
    "db:migrate": "pnpm --filter @finance-os/database run migrate",
    "db:deploy": "pnpm --filter @finance-os/database run migrate:deploy",

    "clean": "turbo run clean"
  },

  "devDependencies": {
    "turbo": "^2.10.4",
    "typescript": "^5.9.3"
  }
}